{
    "swagger": "2.0",
    "info": {
        "description": "Swagger Documentation for text_analyzer app (тестовое задание для компании \"Инсит\")",
        "title": "Swagger Documentation for text_analyzer app",
        "contact": {
            "name": "Fedotv Maxim (developer)",
            "email": "f3d0t0tvmax@yandex.ru"
        },
        "version": "1.0"
    },
    "paths": {
        "/api/v1/analyze": {
            "post": {
                "description": "Analyze text",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "analyzer"
                ],
                "summary": "Analyze text",
                "parameters": [
                    {
                        "description": "Analyze text input",
                        "name": "dto",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/inputs.Text"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.AnalyzeResult"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/domain.Error"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/domain.Error"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/domain.Error"
                        }
                    }
                }
            }
        },
        "/api/v1/health": {
            "get": {
                "description": "health check",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "analyzer"
                ],
                "summary": "health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.Error"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/domain.Error"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "domain.AnalyzeResult": {
            "type": "object",
            "required": [
                "average_word_length",
                "sentences_count",
                "symbols_count",
                "word_count"
            ],
            "properties": {
                "average_word_length": {
                    "type": "number"
                },
                "sentences_count": {
                    "type": "integer"
                },
                "symbols_count": {
                    "type": "integer"
                },
                "word_count": {
                    "type": "integer"
                }
            }
        },
        "domain.Error": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                }
            }
        },
        "inputs.Text": {
            "type": "object",
            "required": [
                "data"
            ],
            "properties": {
                "data": {
                    "type": "string",
                    "example": "test message 123 456 789 test"
                }
            }
        }
    }
}